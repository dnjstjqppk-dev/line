DATABASE_URL=postgres://messenger:messenger_local_only@localhost:5432/messenger?sslmode=disable
JWT_SECRET=replace-with-at-least-32-cryptographically-random-characters
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:1420
PORT=8080
SERVICE_NAME=gateway
# Base64 of an independently generated 32-byte key. Required for token registration.
PUSH_TOKEN_ENCRYPTION_KEY=

# Message body at-rest encryption (AES-256-GCM)
MESSAGE_ENCRYPTION_KEY=

# FCM (Firebase Cloud Messaging)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# APNs (Apple Push Notification service)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false

# Redis (distributed rate limiting)
REDIS_URL=redis://localhost:6379
